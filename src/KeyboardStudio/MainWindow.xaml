<Window x:Class="KeyboardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Studio" Width="1320" Height="860" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg0}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Fg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image x:Name="Logo" Width="30" Height="30" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Keyboard Studio" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="for AJAZZ &amp; AULA keyboards" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="KEYBOARD" Style="{StaticResource Hint}" FontSize="11" Margin="12,0,0,4"/>
                    <StackPanel x:Name="DevicePanel"/>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="6,12,6,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg2}" CornerRadius="10" Padding="12,10">
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Looking for keyboard..." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Fg1}"/>
                    </DockPanel>
                </Border>

                <Border x:Name="BatteryCard" DockPanel.Dock="Bottom" Background="{DynamicResource Bg2}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                        Visibility="Collapsed" AutomationProperties.Name="Battery">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="BatteryIcon" FontFamily="{StaticResource Icons}" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryAge" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryText" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar x:Name="BatteryBar" Maximum="100" Height="4" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="screen" AutomationProperties.Name="Screen" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F4;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Screen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="lighting" AutomationProperties.Name="Lighting" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE706;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Lighting" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="perkey" AutomationProperties.Name="Per-key colors" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE790;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Per-key colors" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="keys" AutomationProperties.Name="Keys" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8AB;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Keys" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="macros" AutomationProperties.Name="Macros" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Macros" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="keyboard" AutomationProperties.Name="Keyboard" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="Keyboard" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" AutomationProperties.Name="App settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE713;" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/>
                            <TextBlock Text="App settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="28,22,28,22" Focusable="False"/>
    </Grid>
</Window>
