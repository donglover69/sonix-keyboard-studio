<UserControl x:Class="KeyboardStudio.Pages.KeyboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Keyboard" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Stored in the keyboard's memory, so they apply on any computer. Sent only when you press Save."/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Gaming locks" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="NoWin" Content="Disable the Windows key"/>
                    <CheckBox x:Name="NoAltTab" Content="Disable Alt + Tab"/>
                    <CheckBox x:Name="NoAltF4" Content="Disable Alt + F4"/>
                    <CheckBox x:Name="FnSwitch" Content="Fn swap (the stock app's fn_switch option)" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Sleep after" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="SleepPanel"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Wireless battery saver. Press any key to wake the keyboard."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Key response (debounce)" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="ResponsePanel"/>
                    <TextBlock x:Name="ResponseInfo" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Primary}" Content="Save to keyboard" Padding="20,9" Click="Save_Click"/>
                <TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
