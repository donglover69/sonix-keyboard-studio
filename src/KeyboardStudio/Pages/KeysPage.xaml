<UserControl x:Class="KeyboardStudio.Pages.KeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KeyboardStudio.Controls"
             Focusable="True" PreviewKeyDown="Page_PreviewKeyDown" PreviewKeyUp="Page_PreviewKeyUp">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Keys" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Give any key a new job, on its own or while Fn is held. Remaps are stored in the keyboard, so they work on any computer. Nothing is sent until you press Apply."/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="Summary" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <WrapPanel x:Name="LayerPanel"/>
                            </DockPanel>
                            <c:KeyboardView x:Name="Board"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Remapped keys" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoRemaps" Style="{StaticResource Hint}" Text="None yet. Click a key above to change what it does."/>
                            <StackPanel x:Name="RemapList"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="KeyTitle" Text="Pick a key" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Text="Click any key on the keyboard picture."/>
                            <StackPanel x:Name="EditorHost" IsEnabled="False">
                                <TextBlock Text="Does" Foreground="{DynamicResource Fg1}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed"/>
                                <StackPanel x:Name="Editor" Margin="0,12,0,0"/>
                                <TextBlock x:Name="EntryHex" Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Button Style="{StaticResource Primary}" Content="Apply to keyboard" Padding="14,9" Click="Apply_Click"/>
                            <TextBlock x:Name="Status" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Reset this layer" Margin="0,0,8,8" Click="ResetLayer_Click"/>
                                <Button Content="Reset all" Margin="0,0,8,8" Click="ResetAll_Click"/>
                                <Button Content="Import from stock app" Margin="0,0,8,8" Click="Import_Click"
                                        ToolTip="Copies the remaps and macros of the stock driver's active profile"/>
                            </WrapPanel>
                            <TextBlock x:Name="ApplyHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Apply writes both layers. Keys you didn't change keep the firmware's own function."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
