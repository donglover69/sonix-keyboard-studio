<UserControl x:Class="KeyboardStudio.Pages.ScreenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KeyboardStudio.Controls"
             AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="Screen" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Drop a GIF, picture or folder of frames anywhere on this page. Nothing is sent to the keyboard until you press Upload."/>
        </StackPanel>

        <!-- Library -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Library" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="Add file..." Click="AddFile_Click" Margin="0,0,4,0"/>
                        <Button Content="Add folder..." Click="AddFolder_Click" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <Button Content="Import from stock app" Click="ImportStock_Click" Margin="0,0,0,10"
                            ToolTip="Copies the animations you made in the official AJAZZ or AULA driver, with their frame timings"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Delete selected" Style="{StaticResource Ghost}" Click="Delete_Click" HorizontalAlignment="Left" Foreground="{DynamicResource Bad}"/>
                <ListBox x:Name="LibraryList" SelectionChanged="Library_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="80" Height="45" CornerRadius="4" Background="Black" Margin="0,0,8,0" ClipToBounds="True">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Preview + upload -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox x:Name="DeviceColors" DockPanel.Dock="Right" Content="Keyboard colors" IsChecked="True" Checked="PreviewMode_Changed" Unchecked="PreviewMode_Changed"
                                      ToolTip="Show the exact 16-bit colors the screen will display"/>
                            <TextBlock x:Name="ItemTitle" Text="No animation selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 240x135 panel shown at 2x inside a bezel -->
                        <Border HorizontalAlignment="Center" Background="#050506" CornerRadius="14" Padding="14" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid Width="480" Height="270">
                                <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"/>
                                <TextBlock x:Name="PreviewHint" Text="240 × 135" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Width="40" Click="Play_Click" Style="{StaticResource Ghost}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Content="&#xE769;" ToolTip="Play / pause"/>
                            <TextBlock x:Name="FrameLabel" DockPanel.Dock="Right" Width="90" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                            <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="FrameSlider_Changed" VerticalAlignment="Center" Margin="6,0"/>
                        </DockPanel>
                        <TextBlock x:Name="InfoText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="WarnText" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="UploadButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Upload to keyboard" Padding="22,10" Click="Upload_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Upload" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UploadHint" Style="{StaticResource Hint}" Text="Requires the USB cable. The keyboard writes ~7 pages per second."/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="UploadProgress" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed"/>
                        <TextBlock x:Name="UploadStatus" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Sync clock now" Click="SyncClock_Click"/>
                            <StackPanel>
                                <TextBlock Text="Screen clock" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="The stock app forced a clock sync (and slot switch) every launch, which is what reset your screen. Here it's opt-in."/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox x:Name="SyncOnConnect" Content="Sync clock when the keyboard connects" Margin="0,10,0,0" Click="ClockOption_Click"/>
                        <CheckBox x:Name="SyncHourly" Content="Keep the clock synced (hourly)" Click="ClockOption_Click"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Screen slot" VerticalAlignment="Center" Width="90" Foreground="{DynamicResource Fg1}"/>
                            <ComboBox x:Name="SlotBox" Width="80" HorizontalAlignment="Left" SelectionChanged="Slot_Changed"
                                      ToolTip="Uploads and clock syncs both use this slot so they never disagree. Leave at 1 unless you know you need another."/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,14,12,4">
                    <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource Ghost}" Click="ResetOptions_Click"/>
                    <TextBlock Text="Adjust" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                    <StackPanel x:Name="Editor" IsEnabled="False">
                        <TextBlock Text="FRAMING" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <RadioButton x:Name="FitFit" Style="{StaticResource Segment}" Content="Fit" GroupName="fit" Checked="Option_Changed" ToolTip="Whole image visible, bars on the sides"/>
                            <RadioButton x:Name="FitFill" Style="{StaticResource Segment}" Content="Fill" GroupName="fit" Checked="Option_Changed" ToolTip="Cover the screen, crop the overflow"/>
                            <RadioButton x:Name="FitStretch" Style="{StaticResource Segment}" Content="Stretch" GroupName="fit" Checked="Option_Changed"/>
                        </WrapPanel>
                        <c:LabeledSlider x:Name="Zoom" Label="Zoom" Minimum="0.5" Maximum="4" Value="1" Format="{}{0:0.00}×" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="PanX" Label="Pan ←→" Minimum="-1" Maximum="1" Value="0" Format="{}{0:+0.00;-0.00;0}" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="PanY" Label="Pan ↑↓" Minimum="-1" Maximum="1" Value="0" Format="{}{0:+0.00;-0.00;0}" ValueChanged="Option_Changed"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="FlipH" Content="Mirror" Margin="0,0,18,0" Click="Option_Changed"/>
                            <CheckBox x:Name="FlipV" Content="Upside down" Click="Option_Changed"/>
                        </WrapPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Background" VerticalAlignment="Center" Foreground="{DynamicResource Fg1}"/>
                            <c:ColorButton x:Name="BgColor" HorizontalAlignment="Right" ColorChanged="Option_Changed"/>
                        </DockPanel>

                        <TextBlock Text="COLOR" Style="{StaticResource H2}"/>
                        <c:LabeledSlider x:Name="Brightness" Label="Brightness" Minimum="-1" Maximum="1" Value="0" Format="{}{0:+0.00;-0.00;0}" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="Contrast" Label="Contrast" Minimum="-1" Maximum="1" Value="0" Format="{}{0:+0.00;-0.00;0}" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="Saturation" Label="Saturation" Minimum="-1" Maximum="1" Value="0" Format="{}{0:+0.00;-0.00;0}" ValueChanged="Option_Changed"/>
                        <CheckBox x:Name="Dither" Content="Dither (smoother gradients)" IsChecked="True" Click="Option_Changed"/>

                        <TextBlock Text="TIMING" Style="{StaticResource H2}"/>
                        <c:LabeledSlider x:Name="Speed" Label="Speed" Minimum="0.25" Maximum="4" Value="1" Format="{}{0:0.00}×" ValueChanged="Option_Changed"/>
                        <CheckBox x:Name="FixedDelayOn" Content="Same delay for every frame" Click="Option_Changed"/>
                        <c:LabeledSlider x:Name="FixedDelay" Label="Frame delay" Minimum="2" Maximum="510" Value="100" Format="{}{0:0} ms" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="TrimStart" Label="Skip first" Minimum="0" Maximum="0" Value="0" Format="{}{0:0} fr" Integer="True" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="TrimEnd" Label="Skip last" Minimum="0" Maximum="0" Value="0" Format="{}{0:0} fr" Integer="True" ValueChanged="Option_Changed"/>
                        <c:LabeledSlider x:Name="FrameStep" Label="Frame step" Minimum="1" Maximum="8" Value="1" Format="every {0:0}" Integer="True" ValueChanged="Option_Changed"
                                         ToolTip="Keep 1 frame out of N; dropped frames' time is added to the kept ones, so the loop length stays the same"/>

                        <TextBlock Text="TEXT OVERLAY" Style="{StaticResource H2}"/>
                        <TextBox x:Name="OverlayText" TextChanged="Option_Changed" ToolTip="Optional text drawn on every frame"/>
                        <c:LabeledSlider x:Name="OverlaySize" Label="Size" Minimum="8" Maximum="72" Value="18" Format="{}{0:0} px" Integer="True" ValueChanged="Option_Changed"/>
                        <ComboBox x:Name="OverlayPos" Margin="0,4,0,0" SelectionChanged="Option_Changed"/>
                        <DockPanel Margin="0,8,0,0">
                            <CheckBox x:Name="OverlayShadow" Content="Shadow" IsChecked="True" Click="Option_Changed"/>
                            <c:ColorButton x:Name="OverlayColor" HorizontalAlignment="Right" ColorChanged="Option_Changed"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
