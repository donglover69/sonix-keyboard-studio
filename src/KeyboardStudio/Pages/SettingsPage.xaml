<UserControl x:Class="KeyboardStudio.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KeyboardStudio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="App settings" Style="{StaticResource H1}"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="Dark" GroupName="theme" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="Light" GroupName="theme" Checked="Theme_Checked"/>
                    </WrapPanel>
                    <TextBlock Text="Accent" Foreground="{DynamicResource Fg1}" Margin="0,10,0,6"/>
                    <WrapPanel x:Name="AccentPanel" VerticalAlignment="Center">
                        <c:ColorButton x:Name="AccentCustom" ColorChanged="AccentCustom_Changed" Margin="4,0,0,8" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <c:LabeledSlider x:Name="ScaleSlider" Label="UI size" Minimum="0.8" Maximum="1.6" Format="{}{0:P0}" ValueChanged="Scale_Changed" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Startup and tray" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="Autostart" Content="Start with Windows" Click="Behaviour_Click"/>
                    <CheckBox x:Name="StartMin" Content="Start hidden in the tray" Click="Behaviour_Click"/>
                    <CheckBox x:Name="CloseTray" Content="Closing the window keeps the app in the tray" Click="Behaviour_Click"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Starting with Windows never touches the screen. It only syncs the clock or restores lighting if you turned that on."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Battery" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="BatteryWarnBox" Content="Notify me when the battery runs low" Click="Battery_Click"/>
                    <c:LabeledSlider x:Name="BatteryWarnSlider" Label="Low at" Minimum="5" Maximum="50" Integer="True" Format="{}{0:0}%" ValueChanged="Battery_Click"/>
                    <c:LabeledSlider x:Name="BatteryPollSlider" Label="Check every" Minimum="10" Maximum="120" Integer="True" Format="{}{0:0} s" ValueChanged="Battery_Click"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="The keyboard only reports its charge in 2.4G mode (read through the dongle, like the stock app every 15 s). In wired mode the last reading is shown."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <c:LabeledSlider x:Name="DelaySlider" Label="Command gap" Minimum="5" Maximum="100" Integer="True" Format="{}{0:0} ms" ValueChanged="Delay_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Pause between USB commands. The stock app uses 35 ms; raise it if commands get lost."/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Open data folder" Click="OpenData_Click" Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="About" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
