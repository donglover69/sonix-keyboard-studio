<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (default). Swapped at runtime by ThemeManager; accent brushes are overwritten from settings. -->
    <SolidColorBrush x:Key="Bg0" Color="#0E0F13"/>
    <SolidColorBrush x:Key="Bg1" Color="#15171C"/>
    <SolidColorBrush x:Key="Bg2" Color="#1C1F26"/>
    <SolidColorBrush x:Key="Bg3" Color="#262A33"/>
    <SolidColorBrush x:Key="Line" Color="#2F3440"/>
    <SolidColorBrush x:Key="Fg0" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="Fg1" Color="#A9AFBC"/>
    <SolidColorBrush x:Key="Fg2" Color="#6E7584"/>
    <SolidColorBrush x:Key="Accent" Color="#B48CFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#33B48CFF"/>
    <SolidColorBrush x:Key="AccentFg" Color="#0E0F13"/>
    <SolidColorBrush x:Key="Good" Color="#5AD18A"/>
    <SolidColorBrush x:Key="Warn" Color="#F0B54A"/>
    <SolidColorBrush x:Key="Bad" Color="#F06A6A"/>
</ResourceDictionary>
